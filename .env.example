# Copy to .env and fill with real values. Never commit the real .env file.

# Postgres connection string used by the app container. Host is "db" (the
# docker-compose service name), not localhost, since app reaches db over the
# internal Docker network.
DATABASE_URL=postgresql://conarem:CHANGE_ME@db:5432/conarem?schema=public

# Password for the Postgres "conarem" role, used by both the db and app
# services (via DATABASE_URL above). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Random secret used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME

# Port the Express app listens on inside the container (must match the
# traefik.http.services.conarem.loadbalancer.server.port label in docker-compose.yml)
PORT=3000

NODE_ENV=production

# Length of the free trial granted on signup, in days
TRIAL_DAYS=14
